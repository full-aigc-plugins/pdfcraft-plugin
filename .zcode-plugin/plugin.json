{
  "name": "pdfcraft",
  "version": "0.1.0-dev.20261024.1",
  "description": "页面重排、扫描件 OCR、表单填写、内容脱敏与印前检查；保留原件，逐页核对顺序、几何与可搜索文本。",
  "license": "Apache-2.0",
  "repository": "https://github.com/full-aigc-plugins/pdfcraft-plugin",
  "homepage": "https://github.com/full-aigc-plugins/pdfcraft-plugin",
  "skills": "./skills/",
  "displayName": "PdfCraft（PDF 处理）",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "pdfcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "zh-CN": "PdfCraft（PDF 处理）"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "PdfCraft (PDF Toolkit)",
          "zh-CN": "PdfCraft（PDF 处理）"
        },
        "icon": "file-text",
        "server": "pdfcraft-editor",
        "resourceUri": "ui://pdfcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
