{
  "name": "printcraft",
  "version": "0.1.0-dev.20261019.1",
  "description": "Page reordering, OCR for scans, form filling, redaction and preflight. Originals are preserved and every page is checked for order, geometry and searchable text.",
  "license": "Apache-2.0",
  "repository": "https://github.com/full-aigc-plugins/printcraft-plugin",
  "homepage": "https://github.com/full-aigc-plugins/printcraft-plugin",
  "interface": {
    "displayName": "PrintCraft · PDF Toolkit",
    "shortDescription": "Page cleanup, OCR, forms, redaction and preflight",
    "category": "Productivity",
    "capabilities": [
      "Read",
      "Write"
    ],
    "logo": "./assets/official-logo.png",
    "logoDark": "./assets/official-logo.png"
  },
  "skills": "./skills/",
  "mcpServers": {
    "printcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "ui/bootstrap.mjs"
      ],
      "cwd": "./"
    }
  }
}
