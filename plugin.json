{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "pdfcraft",
  "version": "0.1.0-dev.20261024.1",
  "description": "页面重排、扫描件 OCR、表单填写、内容脱敏与印前检查；保留原件，逐页核对顺序、几何与可搜索文本。",
  "license": "Apache-2.0",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "PdfCraft（PDF 处理）",
        "shortDescription": "页面整理、OCR、表单、脱敏与印前检查",
        "category": "Productivity",
        "capabilities": [
          "Read",
          "Write"
        ],
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "org.full-aigc.printcraft": {
      "contracts": {
        "execution": "printcraft.execution/1",
        "verification": "printcraft.verification/1",
        "ocr": "printcraft.ocr/1",
        "ocrBackend": "printcraft.ocr-backend/1"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "PrintCraft"
    }
  },
  "repository": "https://github.com/full-aigc-plugins/pdfcraft-plugin",
  "homepage": "https://github.com/full-aigc-plugins/pdfcraft-plugin"
}
